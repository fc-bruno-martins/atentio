# Copie para .env e preencha. Nunca versione o .env.

# OBRIGATÓRIA: senha do PostgreSQL (use só letras e números; vai dentro de URLs de conexão)
POSTGRES_PASSWORD=
# OBRIGATÓRIA: chave de acesso à Evolution API
EVOLUTION_API_KEY=
# OBRIGATÓRIA: segredo dos webhooks da Evolution API para o backend
EVOLUTION_WEBHOOK_SECRET=
# OBRIGATÓRIA: token das chamadas internas dos workers para o backend
INTERNAL_API_TOKEN=

# Opcional: usuário e banco do PostgreSQL
POSTGRES_USER=atentio
POSTGRES_DB=atentio

# Opcional: endereço e portas publicadas no host
BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8180
BACKEND_PORT=8100
MCP_PORT=8101
MAILPIT_PORT=8125

# Opcional: nível de log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Opcional: heartbeat dos workers. Intervalo + TTL definem quando o status acusa falha.
WORKER_HEARTBEAT_INTERVAL_SECONDS=5
WORKER_HEARTBEAT_TTL_SECONDS=20

# Opcional: dias de retenção das mensagens
MESSAGE_RETENTION_DAYS=7

# Opcional: análises. Sem a chave, nenhum conteúdo é enviado ao provedor.
OPENROUTER_API_KEY=
# Opcional: modelo já preenchido na tela. Os modelos vêm da lista do OpenRouter.
OPENROUTER_DEFAULT_MODEL=

# Opcional: endereço público usado nos links de convite e recuperação
PUBLIC_APP_URL=http://localhost:8180
# Opcional: cookie só em HTTPS. Em produção, use true.
COOKIE_SECURE=false

# Opcional: e-mail. O padrão usa o Mailpit local, sem envio real.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=Atentio <nao-responda@atentio.local>
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
